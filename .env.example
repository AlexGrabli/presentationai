# =============================================================================
# PRESENTATION AI - LOCAL AI CONFIGURATION
# =============================================================================
# Скопируйте этот файл в .env.local и заполните своими значениями

# -----------------------------------------------------------------------------
# OLLAMA CONFIGURATION (Локальные LLM модели)
# -----------------------------------------------------------------------------
# URL вашего Ollama сервера (обычно http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Модели, доступные в вашей установке Ollama:
# - qwen3:14b - основная модель для генерации текста презентаций
# - qwen3-coder:30b - для генерации кода и технических презентаций
# - llama3.1:8b - быстрая модель для простых задач
# - deepseek-r1:14b - для сложных математических и логических задач

# Основная модель для генерации контента (по умолчанию)
OLLAMA_DEFAULT_MODEL=qwen3:14b

# Модель для генерации структуры презентации (outline)
OLLAMA_OUTLINE_MODEL=qwen3:14b

# Модель для генерации контента слайдов
OLLAMA_CONTENT_MODEL=qwen3:14b

# Модель для генерации кода
OLLAMA_CODE_MODEL=qwen3-coder:30b

# Быстрая модель для простых задач
OLLAMA_QUICK_MODEL=llama3.1:8b

# Модель для сложных задач (математика, reasoning)
OLLAMA_REASONING_MODEL=deepseek-r1:14b

# Таймаут для запросов к Ollama (в миллисекундах)
OLLAMA_TIMEOUT=120000

# Максимальное количество токенов в ответе
OLLAMA_MAX_TOKENS=4096

# Температура генерации (0.0 - детерминированный, 1.0 - креативный)
OLLAMA_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# STABLE DIFFUSION WEBUI CONFIGURATION (Генерация изображений)
# -----------------------------------------------------------------------------
# URL вашего Stable Diffusion WebUI (AUTOMATIC1111)
SD_WEBUI_URL=http://localhost:7860

# API ключ (если настроен в SD WebUI)
SD_WEBUI_API_KEY=

# Количество шагов генерации (больше = качественнее, но медленнее)
# Рекомендуется 20-30 для RTX 4070ti
SD_STEPS=25

# Разрешение изображений (ширина x высота)
SD_WIDTH=1024
SD_HEIGHT=576

# CFG Scale (насколько строго следовать промпту, 7-12 оптимально)
SD_CFG_SCALE=7.5

# Sampler (алгоритм генерации)
SD_SAMPLER=DPM++ 2M Karras

# Модель Stable Diffusion (название модели из SD WebUI)
SD_MODEL=sd_xl_base_1.0.safetensors

# Таймаут для генерации изображения (в миллисекундах)
SD_TIMEOUT=180000

# -----------------------------------------------------------------------------
# REDIS CACHE CONFIGURATION (Кеширование результатов)
# -----------------------------------------------------------------------------
# URL для подключения к Redis
REDIS_URL=redis://localhost:6379

# Пароль Redis (если установлен)
REDIS_PASSWORD=

# База данных Redis (0-15)
REDIS_DB=0

# TTL для кеша outline (в секундах, 1 час по умолчанию)
REDIS_OUTLINE_TTL=3600

# TTL для кеша слайдов (в секундах, 30 минут по умолчанию)
REDIS_SLIDES_TTL=1800

# TTL для кеша изображений (в секундах, 24 часа по умолчанию)
REDIS_IMAGES_TTL=86400

# Включить кеширование (true/false)
REDIS_ENABLED=true

# -----------------------------------------------------------------------------
# FALLBACK CONFIGURATION (Резервные облачные сервисы)
# -----------------------------------------------------------------------------
# OpenAI API ключ (используется как fallback если Ollama недоступен)
OPENAI_API_KEY=

# Модель OpenAI для fallback
OPENAI_FALLBACK_MODEL=gpt-4-turbo-preview

# Unsplash API ключ (fallback для изображений если SD недоступен)
UNSPLASH_ACCESS_KEY=

# Включить автоматический fallback на облачные сервисы
ENABLE_CLOUD_FALLBACK=true

# -----------------------------------------------------------------------------
# MONITORING & PERFORMANCE
# -----------------------------------------------------------------------------
# Включить мониторинг GPU через nvidia-smi
ENABLE_GPU_MONITORING=true

# Интервал обновления метрик GPU (в миллисекундах)
GPU_MONITORING_INTERVAL=5000

# Включить логирование производительности
ENABLE_PERFORMANCE_LOGGING=true

# Уровень логирования (debug, info, warn, error)
LOG_LEVEL=info

# Сохранять логи в файл
LOG_TO_FILE=false
LOG_FILE_PATH=./logs/presentation-ai.log

# -----------------------------------------------------------------------------
# RATE LIMITING (Ограничение частоты запросов)
# -----------------------------------------------------------------------------
# Максимальное количество одновременных запросов к Ollama
OLLAMA_MAX_CONCURRENT_REQUESTS=2

# Максимальное количество одновременных запросов к SD
SD_MAX_CONCURRENT_REQUESTS=1

# Задержка между запросами (в миллисекундах)
REQUEST_DELAY=1000

# -----------------------------------------------------------------------------
# NEXT.JS CONFIGURATION
# -----------------------------------------------------------------------------
# Режим разработки/продакшн
NODE_ENV=development

# Порт для Next.js сервера
PORT=3000

# Базовый URL приложения
NEXT_PUBLIC_APP_URL=http://localhost:3000
